{
  "manifest_version": 3,
  "name": "Steam Bulk Friend Adder",
  "version": "1.0.0",
  "description": "Paste SteamID64,name lines on your Steam friends page to send friend requests and set nicknames automatically.",
  "permissions": ["storage"],
  "host_permissions": ["https://steamcommunity.com/*"],
  "content_scripts": [
    {
      "matches": [
        "https://steamcommunity.com/id/*/friends*",
        "https://steamcommunity.com/profiles/*/friends*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
